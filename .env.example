# Variables de entorno del proyecto — COPIA DE REFERENCIA (no lleva valores reales).
#
# En producción NO se usa este archivo: las variables se cargan en
# Vercel → proyecto pit-web-v2 → Settings → Environment Variables.
# Este archivo existe solo para documentar qué variables hacen falta.

# Likes compartidos: Vercel los carga al conectar Upstash for Redis.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# También se aceptan UPSTASH_REDIS_REST_URL y UPSTASH_REDIS_REST_TOKEN.
# Opcional: firma estable para la cookie si se rotan las credenciales de Redis.
LIKES_COOKIE_SECRET=
